# NetPulse — variables de entorno de ejemplo
# Copiar a .env (NO versionado) y completar con valores propios.
# Generar valores aleatorios: openssl rand -hex 32

# ── NetBox (docker-compose.netbox.yml) ─────────────────────
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@netpulse.local
NETBOX_SUPERUSER_PASSWORD=cambiame
NETBOX_API_TOKEN=cambiame
NETBOX_API_KEY=cambiame
NETBOX_SECRET_KEY=cambiame
NETBOX_API_TOKEN_PEPPER_1=cambiame
NETBOX_DB_PASSWORD=cambiame

# ── Credenciales de laboratorio (inventory_svc.add_lab_devices) ──
NETPULSE_LAB_PASSWORD=cambiame

# ── Red señuelo / Honeypot (Deception) ─────────────────────
# Deshabilitada por defecto: no se abre ningún puerto señuelo.
# Token compartido con el data plane para POST /api/deception/ingest
# Interfaz del bridge de deception (modo paquete del engine Go)
# Forzar host de bind del motor nativo (vacío = usar la IP de cada dispositivo)
# Alertas de deception
# Bloqueo automático de IPs ante alertas critical
# Reducción de falsos positivos (alertas)
# GeoIP offline (vacío = autodetecta la de maxminddb-geolite2)
NETPULSE_GEOIP_DB=
# Ubicación del centro de datos (punto verde del mapa global)
NETPULSE_DATACENTER_LAT=0
NETPULSE_DATACENTER_LON=0
NETPULSE_DATACENTER_NAME=Data Center
# Firewall: false = dry-run (solo muestra los comandos)
NETPULSE_FIREWALL_ENABLED=false

# ── Alertmanager webhook (auth de servicio) ────────────────
# Token compartido para que Alertmanager autentique el webhook sin JWT.
# Debe coincidir con el "credentials" de config/alertmanager.yml.
# openssl rand -hex 32
NETPULSE_ALERTMANAGER_TOKEN=

# ── Backup offsite (S3/MinIO o SFTP) ───────────────────────
NETPULSE_OFFSITE_ENABLED=false
NETPULSE_OFFSITE_BACKEND=sftp
# SFTP
NETPULSE_OFFSITE_SFTP_HOST=
NETPULSE_OFFSITE_SFTP_PORT=22
NETPULSE_OFFSITE_SFTP_USER=
NETPULSE_OFFSITE_SFTP_PASSWORD=
NETPULSE_OFFSITE_SFTP_KEY=
NETPULSE_OFFSITE_SFTP_DIR=netpulse-backups
# S3 / MinIO (endpoint vacío = AWS)
NETPULSE_OFFSITE_S3_ENDPOINT=
NETPULSE_OFFSITE_S3_BUCKET=
NETPULSE_OFFSITE_S3_REGION=us-east-1
NETPULSE_OFFSITE_S3_ACCESS_KEY=
NETPULSE_OFFSITE_S3_SECRET_KEY=
NETPULSE_OFFSITE_S3_PREFIX=netpulse

# ── Rendimiento / Arquitectura ────────────────────────────
# Colector syslog: batching hacia Loki (cola + flush por intervalo).
NETPULSE_SYSLOG_PORT=5514
NETPULSE_SYSLOG_BATCH_INTERVAL=0.5
NETPULSE_SYSLOG_BATCH_MAX=1000
NETPULSE_SYSLOG_QUEUE_MAX=20000
# Sondeo de métricas en paralelo.
NETPULSE_POLL_WORKERS=8
# Concurrencia: sesiones simultáneas por dispositivo y tope global.
NETPULSE_PER_DEVICE_CONCURRENCY=2
NETPULSE_MAX_DEVICE_CONCURRENCY=16

# ── Máquinas señuelo (VMs con QEMU) ────────────────────────
# Crear VMs señuelo, subir ISO y arrancarlas (consola por VNC).
# Requiere QEMU en el host: brew install qemu / apt install qemu-system

# ── Capa de decisiones IA (Laya — alternativa libre y multilingüe a Jev) ──
# Motor "System One" servido por HTTP (docker-compose.ai.yml, puerto 8090).
# Deshabilitado por defecto: todo cae de vuelta a la lógica por reglas.
NETPULSE_AI_ENABLED=false
# Backend: "laya" (HTTP) o "stub" (offline, sin modelo).
NETPULSE_AI_BACKEND=laya
NETPULSE_AI_BASE_URL=http://localhost:8090
NETPULSE_AI_MODEL=multilingual
# Confianza mínima para actuar sobre una decisión (gating).
NETPULSE_AI_CONFIDENCE_FLOOR=0.90
NETPULSE_AI_TIMEOUT=8
NETPULSE_AI_CACHE_TTL=300
NETPULSE_AI_JEV_STRICT=true

# ── Falsos positivos de deception con IA ───────────────────
# Clasificar cada alerta señuelo como benigna/intrusión real.
# Permitir que la IA silencie una alerta cuando la clasifica como benigna.
