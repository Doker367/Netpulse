# netpulse-noc — variables de entorno de ejemplo
# Copiar a .env (NO versionado) y completar con valores propios.
# Generar valores aleatorios: openssl rand -hex 32
# Este producto administra equipos reales: use secretos exclusivos del NOC.

# ── Usuarios iniciales (scripts/seed_users.py) ─────────────
# Sin valores por defecto: el script exige estas variables.
NETPULSE_ADMIN_PASSWORD=
NETPULSE_OPERATOR_PASSWORD=

# ── API ────────────────────────────────────────────────────
# Enlace local por defecto; exponga solo detrás de TLS/reverse proxy.
NETPULSE_HOST=127.0.0.1
NETPULSE_PORT=8082
# legacy (por defecto): panel HTML anterior en /. react: React en / si hay build.
# /modern mantiene React y /legacy mantiene el panel HTML en ambos modos.
NETPULSE_FRONTEND=legacy
NETPULSE_SSL_CERTFILE=
NETPULSE_SSL_KEYFILE=

# ── NetBox (docker-compose.netbox.yml) ─────────────────────
NETBOX_URL=http://localhost:8000
NETBOX_SUPERUSER_NAME=admin
NETBOX_SUPERUSER_EMAIL=admin@netpulse.local
NETBOX_SUPERUSER_PASSWORD=cambiame
NETBOX_DB_PASSWORD=cambiame

# NetBox 4.x exige >=50 caracteres en SECRET_KEY y en cada API_TOKEN_PEPPER_*;
# si son más cortos el contenedor no arranca (falla con "Waiting on DB").
# Generar con:  openssl rand -hex 32
NETBOX_SECRET_KEY=
NETBOX_API_TOKEN_PEPPER_1=

# Token del superusuario que crea el bootstrap de netboxcommunity/netbox:
#   NETBOX_API_TOKEN -> token EN CLARO que usará NetPulse (40 caracteres).
#                       Los tokens v2 no se guardan legibles en la BD, así que
#                       este valor es el único lugar donde existe.
#   NETBOX_API_KEY   -> clave corta del token: MÁXIMO 12 caracteres (varchar(12)).
#   NETBOX_TOKEN     -> lo lee la API de NetPulse (app/core/settings.py). Para un
#                       token v2 debe ser la credencial completa que emite NetBox:
#                       nbt_<key>.<token>   (si empieza por nbt_ se envía como
#                       "Authorization: Bearer ...", si no, como "Token ...").
NETBOX_API_TOKEN=
NETBOX_API_KEY=
NETBOX_TOKEN=

# ── Credenciales de laboratorio (inventory_svc.add_lab_devices) ──
# Solo para el laboratorio sintético; nunca para equipos de producción.
NETPULSE_LAB_PASSWORD=cambiame

# ── SNMP ───────────────────────────────────────────────────
NETPULSE_SNMP_COMMUNITY=
NETPULSE_SNMP_TIMEOUT=5

# ── Colectores (deshabilitados por defecto) ────────────────
# Habilitar solo durante una ventana autorizada para evitar doble sondeo.
NETPULSE_SYSLOG_ENABLED=false
NETPULSE_SYSLOG_HOST=127.0.0.1
NETPULSE_SYSLOG_PORT=5514
NETPULSE_SYSLOG_BATCH_INTERVAL=0.5
NETPULSE_SYSLOG_BATCH_MAX=1000
NETPULSE_SYSLOG_QUEUE_MAX=20000
NETPULSE_METRICS_ENABLED=false
NETPULSE_METRICS_INTERVAL=60
NETPULSE_LOKI_URL=http://localhost:3100

# ── Rendimiento / Arquitectura ────────────────────────────
NETPULSE_POLL_WORKERS=8
NETPULSE_PER_DEVICE_CONCURRENCY=2
NETPULSE_MAX_DEVICE_CONCURRENCY=16
NAPALM_TIMEOUT=60

# ── Firewalls (FortiOS) ───────────────────────────────────
NETPULSE_FIREWALL_ENABLED=false
NETPULSE_FORTIOS_VERIFY=false
NETPULSE_FORTIOS_TIMEOUT=10

# ── Capa de decisiones IA (Laya) ──────────────────────────
# Deshabilitada por defecto: todo cae de vuelta a la lógica por reglas.
NETPULSE_AI_ENABLED=false
NETPULSE_AI_BACKEND=laya
NETPULSE_AI_BASE_URL=http://127.0.0.1:8090
NETPULSE_AI_MODEL=multilingual
NETPULSE_AI_CONFIDENCE_FLOOR=0.90
NETPULSE_AI_TIMEOUT=8
NETPULSE_AI_CACHE_TTL=300
NETPULSE_AI_JEV_STRICT=true

# ── Notificaciones ────────────────────────────────────────
NETPULSE_TELEGRAM_TOKEN=
NETPULSE_TELEGRAM_CHAT_ID=
NETPULSE_SLACK_WEBHOOK_URL=
NETPULSE_SLACK_CHANNEL=
NETPULSE_SMTP_HOST=
NETPULSE_SMTP_PORT=25
NETPULSE_SMTP_USERNAME=
NETPULSE_SMTP_PASSWORD=
NETPULSE_SMTP_FROM=netpulse@localhost
NETPULSE_SMTP_TO=

# ── Alertmanager webhook (auth de servicio) ───────────────
NETPULSE_ALERTMANAGER_TOKEN=

# ── Backup offsite (S3/MinIO o SFTP) ──────────────────────
NETPULSE_OFFSITE_ENABLED=false
NETPULSE_OFFSITE_BACKEND=sftp
NETPULSE_OFFSITE_SFTP_HOST=
NETPULSE_OFFSITE_SFTP_PORT=22
NETPULSE_OFFSITE_SFTP_USER=
NETPULSE_OFFSITE_SFTP_PASSWORD=
NETPULSE_OFFSITE_SFTP_KEY=
NETPULSE_OFFSITE_SFTP_DIR=netpulse-backups
NETPULSE_OFFSITE_S3_ENDPOINT=
NETPULSE_OFFSITE_S3_BUCKET=
NETPULSE_OFFSITE_S3_REGION=us-east-1
NETPULSE_OFFSITE_S3_ACCESS_KEY=
NETPULSE_OFFSITE_S3_SECRET_KEY=
NETPULSE_OFFSITE_S3_PREFIX=netpulse
